<%-
/* ============================================================
   layout/index.ejs — 首页
   变更：新增 Hero、语义 h2、日期/分类/阅读时长元信息行、
        摘要统一 120 字 + CSS 两行截断、独立「阅读全文」链接、自定义分页
   Hero 文案在下方硬编码，按喜好改即可；config.description 为空时回退用 subtitle。
   ============================================================ */
'' %>
<%
  /* 自带纯文本提取 + 计数，不依赖 strip_html / toArray / length */
  function plainText(html) {
    return String(html || '')
      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&[a-zA-Z#0-9]+;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }
  var postCount = 0;
  var latestDate = '';
  var scan = 0;
  site.posts.sort('date', -1).each(function (post) {
    postCount++;
    if (scan === 0) latestDate = date(post.date, 'YYYY.MM.DD');
    scan++;
  });
  var idx = 0;
%>
<% /* Hero 只在首页第一屏出现，翻页后不重复占用首屏 */ %>
<% if (!page.current || page.current === 1) { %>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">Hi, I'm <%= config.author || 'Mazy' %></p>
    <h1>写点代码，也记录生活。</h1>
    <p class="hero-desc"><%= config.description || config.subtitle || '记录一些想法、读书与生活。' %></p>
    <div class="hero-meta">
      <span><%= postCount %> 篇文章</span>
      <% if (latestDate) { %><span>最近更新 <%= latestDate %></span><% } %>
      <a href="<%- url_for('/about') %>">关于我 →</a>
    </div>
  </div>
  <div class="avatar" aria-hidden="true"><%= (config.author || 'M')[0] %></div>
</section>
<% } %>

<div class="list-head">
  <h2>最新文章</h2>
  <span>共 <%= postCount %> 篇 · 按时间倒序</span>
</div>

<div class="post-list">
<% page.posts.each(function (post) { %>
<%
  var summary = plainText(post.excerpt || post.content || '');
  var excerpt = summary.length > 120 ? summary.slice(0, 120) + '…' : summary;
  var firstCat = '';
  if (post.categories) { post.categories.each(function (c) { if (!firstCat) firstCat = c.name; }); }
  var minutes = Math.max(1, Math.ceil(plainText(post.content || '').length / 400));
%>
  <article class="post-item">
    <div class="post-item-extra">
      <time class="date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
      <% if (firstCat) { %><span class="tag"><%= firstCat %></span><% } %>
      <span class="read-time">约 <%= minutes %> 分钟</span>
      <% if (idx === 0) { %><span class="badge-new">最新</span><% } %>
      <div class="tags">
        <% post.tags.each(function (tag) { %>
        <a class="tag-item" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }); %>
      </div>
    </div>
    <h2 class="post-item-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
    <p class="post-excerpt"><%= excerpt %></p>
    <a class="read-more" href="<%- url_for(post.path) %>">阅读全文 →</a>
  </article>
<% idx++; %>
<% }); %>
</div>

<% if (page.total > 1) { %>
<nav class="paginator" aria-label="分页">
  <% if (page.current > 1) { %>
  <a class="extend prev" rel="prev" href="<%- url_for(page.current === 2 ? '/' : '/page/' + (page.current - 1) + '/') %>">← 上一页</a>
  <% } %>
  <% for (var i = 1; i <= page.total; i++) { %>
    <% if (i === page.current) { %>
  <span class="page-number current" aria-current="page"><%= i %></span>
    <% } else { %>
  <a class="page-number" href="<%- url_for(i === 1 ? '/' : '/page/' + i + '/') %>"><%= i %></a>
    <% } %>
  <% } %>
  <% if (page.current < page.total) { %>
  <a class="extend next" rel="next" href="<%- url_for('/page/' + (page.current + 1) + '/') %>">下一页 →</a>
  <% } %>
</nav>
<% } %>
