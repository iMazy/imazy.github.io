<%-
/* ============================================================
   layout/post.ejs — 文章页
   变更：<h1> 标题、去掉嵌套 <main>、统一日期格式、补阅读时长与上一篇/下一篇
   ============================================================ */
'' %>
<%
  function plainText(html) {
    return String(html || '')
      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&[a-zA-Z#0-9]+;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }
  var minutes = Math.max(1, Math.ceil(plainText(page.content || '').length / 400));
%>
<article class="post">
  <h1 class="post-title"><%= page.title %></h1>
  <div class="post-meta">
    <time class="date" datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time>
    <div class="tags">
      <% page.categories.each(function (category) { %>
      <a class="tag-item" href="<%- url_for(category.path) %>"><%= category.name %></a>
      <% }); %>
      <% page.tags.each(function (tag) { %>
      <a class="tag-item" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
      <% }); %>
    </div>
    <span class="read-time">约 <%= minutes %> 分钟</span>
  </div>
  <div class="post-content"><%- page.content %></div>
</article>

<% if (page.prev || page.next) { %>
<nav class="post-nav" aria-label="文章导航">
  <% if (page.prev) { %><a class="post-nav-prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
  <% if (page.next) { %><a class="post-nav-next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
</nav>
<% } %>
