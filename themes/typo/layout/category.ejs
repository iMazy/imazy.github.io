<%
  var posts = page.posts ? page.posts.toArray() : [];
%>
<h1 class="archive-title">分类：<%= page.category %></h1>
<ul class="archives">
<% posts.forEach(function (post) { %>
  <li class="archive-item">
    <time class="date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
    <a class="title" href="<%- url_for(post.path) %>"><%= post.title %></a>
  </li>
<% }); %>
</ul>
